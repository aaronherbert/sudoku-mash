{
  "name": "sudoku-mash",
  "private": true,
  "version": "0.1.0",
  "description": "Sudoku Mash: real-time peer-to-peer multiplayer Sudoku.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-contrast.mjs",
    "test:watch": "vitest",
    "link:tide": "node scripts/link-tide.mjs"
  },
  "dependencies": {
    "@aaronherbert/design-system": "^0.2.0",
    "peerjs": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
